# SQLite for local dev — swap to a Postgres connection string later, same Prisma schema.
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Add BOTH redirect URIs to the same client — sign-in and the separate GTM
# connection flow share one Google Cloud OAuth client, but are otherwise
# independent (see lib/gtm/oauth.ts for why GTM access is a second grant):
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/gtm/callback
# Also enable "Tag Manager API" under APIs & Services > Library — the OAuth
# client alone isn't enough, the API itself must be enabled on the project.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Error monitoring (Sentry) ---
# 1. Create a project at https://sentry.io (or self-hosted) — platform: Next.js.
# 2. Settings > Client Keys (DSN) on that project gives you the DSN below.
#    Same DSN for server + client; NEXT_PUBLIC_SENTRY_DSN is exposed to the
#    browser bundle so React rendering errors in the dashboard/ops UI are
#    captured too, not just the API routes.
# 3. In Sentry, set up an Alert Rule on this project: "An event is seen" with
#    tag `push_outcome:partial` -> notify (email/Slack/PagerDuty, your call).
#    That's the one that means "a client's GTM workspace is half-wired" —
#    treat it as page-worthy, unlike a plain `failed` push (nothing was
#    created, so nothing is broken, it's just annoying).
# 4. SENTRY_AUTH_TOKEN/SENTRY_ORG/SENTRY_PROJECT are only needed if you want
#    readable stack traces (source map upload) in production builds —
#    Settings > Auth Tokens, scope: project:releases. Leave blank for local
#    dev; the build skips source map upload without a token.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Email allowed to view /ops (the internal setup-attempts/error dashboard —
# not shown to clients). Must match the Google account you sign in with.
ADMIN_EMAIL=""
