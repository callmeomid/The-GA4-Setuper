# SQLite for local dev — swap to a Postgres connection string later, same Prisma schema.
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Add ALL redirect URIs below to the same client — sign-in, GTM, and GA4 are
# three independent grants sharing one Google Cloud OAuth client (see
# lib/gtm/oauth.ts and lib/ga4/oauth.ts for why each is its own grant):
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/gtm/callback
#   http://localhost:3000/api/ga4/callback
# Also enable these APIs under APIs & Services > Library — the OAuth client
# alone isn't enough, each API must be enabled on the project:
#   - Tag Manager API
#   - Google Analytics Admin API
#   - Google Analytics Data API
#   - BigQuery API (only needed if you link a GA4 BigQuery export and want
#     validation to confirm against it instead of just Realtime)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stape.io has no OAuth — each user pastes their own API key into Settings
# at runtime (see lib/stape/client.ts). Nothing to configure here.
