# SQLite for local dev — swap to a Postgres connection string later, same Prisma schema.
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Add BOTH redirect URIs to the same client — sign-in and the separate GTM
# connection flow share one Google Cloud OAuth client, but are otherwise
# independent (see lib/gtm/oauth.ts for why GTM access is a second grant):
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/gtm/callback
# Also enable "Tag Manager API" under APIs & Services > Library — the OAuth
# client alone isn't enough, the API itself must be enabled on the project.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Used to build absolute redirect URLs for Stripe Checkout/Portal/redeem links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=""
# Stripe Dashboard > Developers > Webhooks > (your endpoint) > Signing secret
# Endpoint URL to register: {NEXT_PUBLIC_APP_URL}/api/stripe/webhook
# Events to send: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=""
# Stripe Dashboard > Product catalog — recurring monthly Price IDs for the two paid tiers.
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""

# Optional: run `npm run seed` after signing in once to grant yourself
# /admin/vouchers access (see prisma/seed.ts).
ADMIN_EMAIL=""
