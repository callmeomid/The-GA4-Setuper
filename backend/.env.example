# SQLite for local dev — swap to a Postgres connection string later, same Prisma schema.
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Add BOTH redirect URIs to the same client — sign-in and the separate GTM
# connection flow share one Google Cloud OAuth client, but are otherwise
# independent (see lib/gtm/oauth.ts for why GTM access is a second grant):
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/gtm/callback
# Also enable "Tag Manager API" under APIs & Services > Library — the OAuth
# client alone isn't enough, the API itself must be enabled on the project.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Only needed for server-side setups (client-side funnels never touch this).
# From your Stape.io account — see lib/stape/client.ts for the API-shape
# caveat: verify against Stape's current docs before first live use.
STAPE_API_KEY=""
# Uncomment to point at a non-default Stape API host (e.g. a sandbox):
# STAPE_API_BASE_URL="https://api.stape.io"
