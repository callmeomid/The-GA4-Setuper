# SQLite for local dev — swap to a Postgres connection string later, same Prisma schema.
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Add BOTH redirect URIs to the same client — sign-in and the separate GTM
# connection flow share one Google Cloud OAuth client, but are otherwise
# independent (see lib/gtm/oauth.ts for why GTM access is a second grant):
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/gtm/callback
# Also enable "Tag Manager API" under APIs & Services > Library — the OAuth
# client alone isn't enough, the API itself must be enabled on the project.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Master key (KEK) that wraps each workspace's token-encryption key — see
# lib/crypto/. Generate one with: openssl rand -base64 32
# Format is "<version>:<base64 key>[,<version>:<base64 key>...]" — a single
# "1:..." entry is enough to start. To rotate, add a new highest version
# (e.g. "1:<old>,2:<new>") and re-run a re-wrap script for existing
# workspaces; never remove an old version until nothing references it anymore.
# Keep this out of git and out of the database — .env is already gitignored.
TOKEN_ENCRYPTION_KEYS=""
