# SQLite for local dev — swap to a Postgres connection string later, same Prisma schema.
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Add ALL THREE redirect URIs to the same client — sign-in, GTM, and GA4 are
# three independent grants sharing one Google Cloud OAuth client (see
# lib/gtm/oauth.ts and lib/ga4/oauth.ts for why each is separate):
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/gtm/callback
#   http://localhost:3000/api/ga4/callback
# Also enable these under APIs & Services > Library — the OAuth client alone
# isn't enough, each API must be enabled on the project:
#   - Tag Manager API        (GTM connect + push)
#   - Google Analytics Admin API   (listing GA4 properties/data streams)
#   - Google Analytics Data API    (the realtime validate step)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Shown as the "Install the extension" button href during onboarding. There's
# no public Chrome Web Store listing yet — point this at wherever you're
# distributing the unpacked/dev build until there is one. Leave unset and the
# onboarding page skips the button, just showing instructions instead.
NEXT_PUBLIC_EXTENSION_URL=""
