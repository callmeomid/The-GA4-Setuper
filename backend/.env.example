# SQLite for local dev — swap to a Postgres connection string later, same Prisma schema.
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Add ALL THREE redirect URIs to the same client — sign-in, GTM, and GA4 each
# request a separate incremental OAuth grant (see lib/gtm/oauth.ts and
# lib/ga4/oauth.ts for why), but all three share one Google Cloud OAuth client:
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/gtm/callback
#   http://localhost:3000/api/ga4/callback
# Also enable these under APIs & Services > Library — the OAuth client alone
# isn't enough, each API must be enabled on the project:
#   - Tag Manager API           (GTM push)
#   - Google Analytics Admin API (GA4 conversion events, data streams)
#   - Google Analytics Data API  (GA4 realtime validation)
#   - BigQuery API                (validation, only if using the BigQuery method)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stape auth is a pasted API key (see Settings), not OAuth — nothing to set
# here. Override only if you need to point at something other than the
# production Stape API (e.g. a mock during development):
# STAPE_API_BASE_URL="https://api.stape.io"
