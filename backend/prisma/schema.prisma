// SQLite for local dev/MVP: zero-ops, file-based, plenty fast for one marketer's
// occasional funnel captures. No native enum support on this connector, so status
// fields below are plain strings validated in application code (lib/schema.ts) —
// that also keeps the schema portable when this datasource swaps to Postgres.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Personal ingestion token the Chrome extension sends as `Authorization: Bearer <apiKey>`.
  // The extension can't do an OAuth redirect flow from a background fetch, so it
  // authenticates with this instead of a browser session.
  apiKey        String    @unique @default(cuid())
  accounts      Account[]
  sessions      Session[]
  funnels       Funnel[]
  gtmConnection   GtmConnection?
  ga4Connection   Ga4Connection?
  stapeConnection StapeConnection?
}

// A *separate* OAuth grant from sign-in (see lib/gtm/oauth.ts) — requested only
// when the user clicks "Connect Google Tag Manager", scoped to
// tagmanager.readonly + tagmanager.edit.containers. We deliberately never
// request tagmanager.publish, so this app is structurally incapable of
// publishing a GTM container, not just "coded not to."
model GtmConnection {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken         String
  accessToken          String?
  accessTokenExpiresAt DateTime?
  gtmAccountId         String?
  gtmContainerId       String?
  gtmContainerPublicId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// Separate incremental OAuth grant (see lib/ga4/oauth.ts), scoped to
// analytics.edit. Unlike GTM, the GA4 Admin API has no draft/publish split —
// there is no scope we can withhold to make writes structurally non-live, so
// every write this connection makes (a conversion event, an MP secret) takes
// effect on the real property immediately. The preview UI says so explicitly.
model Ga4Connection {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken         String
  accessToken          String?
  accessTokenExpiresAt DateTime?
  ga4PropertyId         String?
  ga4PropertyDisplayName String?
  ga4MeasurementId       String?
  ga4DataStreamName      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// Stape has no OAuth — access is a personal API key generated in Stape's
// account settings, sent as X-AUTH-TOKEN on every request (see
// lib/stape/client.ts). Stored the same way the extension's own apiKey is:
// a bearer secret, not an OAuth token.
model StapeConnection {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey            String
  region            String   @default("global") // "global" | "eu"
  containerIdentifier String?
  containerName     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Funnel {
  id        String       @id @default(cuid())
  name      String
  // "draft" | "approved"
  status    String       @default("draft")
  ownerId   String
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  steps     FunnelStep[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Set once we create (or reuse) the dedicated GTM workspace for this funnel.
  gtmWorkspaceId   String?
  ga4MeasurementId String?
  // Name of the GA4 Configuration tag every event tag references — either one
  // we created, or an existing one we found and reused (see lib/gtm/plan.ts).
  ga4ConfigTagName String?

  // GA4 property this funnel's conversion events were written to — set once
  // ga4-push runs. Independent of the GtmConnection's own account-wide
  // selection, since a funnel can target a different property.
  ga4PropertyId String?

  // Null until the user answers the "does this funnel span subdomains?"
  // question in the Stape setup flow — that answer materially changes the
  // domain/cookie plan (see lib/stape/plan.ts), so we ask instead of guessing.
  stapeSpansSubdomains Boolean?
  stapeContainerIdentifier String?

  apiLogs         ApiLog[]
  validationRuns  ValidationRun[]
}

// Persisted (not just console.log'd) so every third-party API call made on
// behalf of this funnel stays inspectable after the fact for debugging.
// Covers GTM, GA4, and Stape — one shared log shape, distinguished by
// `system`, so the log viewer and retention logic don't triplicate.
model ApiLog {
  id       String  @id @default(cuid())
  // "gtm" | "ga4" | "stape"
  system   String  @default("gtm")
  // Nullable: some calls (listing accounts/containers while connecting)
  // happen before a funnel is in scope. Push-execution calls always set this.
  funnelId String?
  funnel   Funnel? @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  // Plain field, not a relation — this is transient debug data, not something
  // we need referential integrity on.
  userId         String?
  method         String
  endpoint       String
  requestBody    String?
  responseStatus Int?
  responseBody   String?
  durationMs     Int?
  errorMessage   String?
  createdAt      DateTime @default(now())

  @@index([funnelId, createdAt])
  @@index([funnelId, system, createdAt])
}

// One row per "run validation" click. Per-step results are JSON-encoded
// (StepValidationResult[]) rather than a child table — SQLite has no native
// array column and this data is never queried per-field, only rendered.
model ValidationRun {
  id          String   @id @default(cuid())
  funnelId    String
  funnel      Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  userId      String
  // "ga4_realtime" | "bigquery" — which read API confirmed landing.
  source      String
  resultsJson String
  overallPass Boolean
  createdAt   DateTime @default(now())

  @@index([funnelId, createdAt])
}

model FunnelStep {
  id       String @id @default(cuid())
  funnelId String
  funnel   Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  order    Int
  label    String

  urlPattern String
  // "click" | "pageview" | "formSubmit"
  triggerType String
  selector    String?
  // JSON-encoded string[] — SQLite has no native array/list column type.
  formFieldsJson String?

  // Generation status stubs — always "pending" until the GTM/GA4/Stape
  // generation logic exists. Kept as three separate columns (not one) because
  // the dashboard needs to show progress per downstream system independently.
  gtmStatus   String @default("pending")
  ga4Status   String @default("pending")
  stapeStatus String @default("pending")

  // Set once created/reused in GTM, so re-running the push is idempotent
  // (skip/update instead of creating duplicates).
  gtmTriggerId String?
  gtmTagId     String?
  // GA4 event name shown+editable in the preview UI before push; derived by
  // lib/gtm/event-name.ts but the user's edit always wins. Doubles as the
  // name registered as a GA4 Admin API conversion event — the two must match
  // for marking it "conversion" to actually apply to the incoming hits.
  ga4EventName String?
  // Resource name (properties/{p}/conversionEvents/{c}) of the GA4 Admin API
  // conversion event, once created — lets ga4-push tell "already registered
  // by us" apart from "another conversion event happens to share this name."
  ga4ConversionEventResourceName String?

  @@index([funnelId, order])
}
