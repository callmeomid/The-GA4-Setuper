// SQLite for local dev/MVP: zero-ops, file-based, plenty fast for one marketer's
// occasional funnel captures. No native enum support on this connector, so status
// fields below are plain strings validated in application code (lib/schema.ts) —
// that also keeps the schema portable when this datasource swaps to Postgres.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Personal ingestion token the Chrome extension sends as `Authorization: Bearer <apiKey>`.
  // The extension can't do an OAuth redirect flow from a background fetch, so it
  // authenticates with this instead of a browser session.
  apiKey        String    @unique @default(cuid())

  // "free" | "pro" | "business" — synced from Stripe subscription webhooks, never
  // set directly by the user. Read by lib/billing/limits.ts to size the funnel-push cap.
  plan                 String    @default("free")
  // Mirrors the Stripe subscription status ("active" | "trialing" | "past_due" |
  // "canceled" | "unpaid" | null). Anything other than active/trialing is treated
  // as free-tier limits by lib/billing/plans.ts, even if `plan` still says otherwise.
  planStatus           String?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?

  // Gates /admin/vouchers. Set manually (seed/DB), never via the API.
  isAdmin       Boolean   @default(false)

  accounts      Account[]
  sessions      Session[]
  funnels       Funnel[]
  gtmConnection GtmConnection?
}

// A *separate* OAuth grant from sign-in (see lib/gtm/oauth.ts) — requested only
// when the user clicks "Connect Google Tag Manager", scoped to
// tagmanager.readonly + tagmanager.edit.containers. We deliberately never
// request tagmanager.publish, so this app is structurally incapable of
// publishing a GTM container, not just "coded not to."
model GtmConnection {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken         String
  accessToken          String?
  accessTokenExpiresAt DateTime?
  gtmAccountId         String?
  gtmContainerId       String?
  gtmContainerPublicId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Funnel {
  id        String       @id @default(cuid())
  name      String
  // "draft" | "approved"
  status    String       @default("draft")
  ownerId   String
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  steps     FunnelStep[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Set once we create (or reuse) the dedicated GTM workspace for this funnel.
  gtmWorkspaceId   String?
  ga4MeasurementId String?
  // Name of the GA4 Configuration tag every event tag references — either one
  // we created, or an existing one we found and reused (see lib/gtm/plan.ts).
  ga4ConfigTagName String?

  // Chosen after approval, before any API calls: null | "client" | "server".
  // Null routes the funnel page to the decision step instead of GTM setup.
  // Switching an existing "client" funnel to "server" later is how the
  // upgrade path works — see lib/stape/setup.ts and plan.ts's 'upgrade'
  // outcome, which detects and edits the GA4 config tag this app already
  // created instead of creating a duplicate.
  setupMode String?

  // Populated only once setupMode is "server" and Stape setup has run.
  stapeContainerId     String?
  stapeSubdomain       String?
  stapeContainerUrl    String?
  // "pending" | "created" | "healthy" | "unreachable"
  stapeContainerStatus String  @default("pending")
  stapeCookieName      String?

  // Stamped the first time this funnel is successfully pushed to GTM — used
  // by lib/billing/limits.ts to count a plan's funnel-push cap against.
  firstPushedAt DateTime?

  gtmApiLogs GtmApiLog[]
}

// Persisted (not just console.log'd) so every GTM API call made on behalf of
// this funnel stays inspectable after the fact for debugging.
model GtmApiLog {
  id       String  @id @default(cuid())
  // Nullable: some calls (listing accounts/containers while connecting GTM)
  // happen before a funnel is in scope. Push-execution calls always set this.
  funnelId String?
  funnel   Funnel? @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  // Plain field, not a relation — this is transient debug data, not something
  // we need referential integrity on.
  userId         String?
  method         String
  endpoint       String
  requestBody    String?
  responseStatus Int?
  responseBody   String?
  durationMs     Int?
  errorMessage   String?
  createdAt      DateTime @default(now())

  @@index([funnelId, createdAt])
}

model FunnelStep {
  id       String @id @default(cuid())
  funnelId String
  funnel   Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  order    Int
  label    String

  urlPattern String
  // "click" | "pageview" | "formSubmit"
  triggerType String
  selector    String?
  // JSON-encoded string[] — SQLite has no native array/list column type.
  formFieldsJson String?

  // Generation status stubs — always "pending" until the GTM/GA4/Stape
  // generation logic exists. Kept as three separate columns (not one) because
  // the dashboard needs to show progress per downstream system independently.
  gtmStatus   String @default("pending")
  ga4Status   String @default("pending")
  stapeStatus String @default("pending")

  // Set once created/reused in GTM, so re-running the push is idempotent
  // (skip/update instead of creating duplicates).
  gtmTriggerId String?
  gtmTagId     String?
  // GA4 event name shown+editable in the preview UI before push; derived by
  // lib/gtm/event-name.ts but the user's edit always wins.
  ga4EventName String?

  @@index([funnelId, order])
}

// Admin-managed discount codes (see /admin/vouchers, lib/billing/vouchers.ts).
// Percent/amount vouchers are mirrored into a real Stripe Coupon + PromotionCode
// so they're typeable at Stripe Checkout's native promo-code field. Trial-day
// vouchers have no Stripe counterpart — trial_period_days can't be attached to a
// coupon, so they only work through the pre-applied /billing/redeem link, which
// builds the Checkout Session with the trial baked in directly.
model Voucher {
  id   String @id @default(cuid())
  code String @unique

  // "percent_off" | "amount_off" | "trial_days"
  type String
  // percent_off: 1-100. amount_off: minor currency units (cents). trial_days: whole days.
  value    Int
  // Required for amount_off only, e.g. "usd".
  currency String?

  // Applies to percent_off/amount_off only — "once" | "repeating" | "forever".
  duration         String?
  // Required when duration = "repeating".
  durationInMonths Int?

  // Redemption window. Both optional — null startsAt means valid immediately,
  // null endsAt means no expiry.
  startsAt DateTime?
  endsAt   DateTime?

  maxRedemptions Int?
  timesRedeemed  Int @default(0)

  // Manual kill switch independent of the redemption window/count.
  active Boolean @default(true)

  // Set only for percent_off/amount_off vouchers — the mirrored Stripe objects.
  stripeCouponId         String?
  stripePromotionCodeId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
